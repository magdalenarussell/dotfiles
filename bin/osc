#!/bin/bash
# Simple OSC 52 clipboard tool (replaces github.com/theimpostor/osc)
# Only implements 'copy' - sends raw OSC 52, works with tmux allow-passthrough

set -euo pipefail

usage() {
    echo "Usage: osc copy [file]"
    echo "       echo 'text' | osc copy"
    exit 1
}

case "${1:-}" in
    copy)
        shift
        if [[ -n "${1:-}" ]]; then
            if [[ -f "$1" ]]; then
                data=$(base64 < "$1" | tr -d '\n')
            else
                echo "Error: $1 is not a file" >&2
                exit 1
            fi
        else
            data=$(base64 | tr -d '\n')
        fi
        printf '\e]52;c;%s\e\\' "$data"
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        echo "Error: unknown command '$1'" >&2
        usage
        ;;
esac
